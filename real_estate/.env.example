# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=boat
POSTGRES_PASSWORD=boat
POSTGRES_DB=boat_storage_db
DB_HOST=localhost
DB_PORT=5432

# Full SQLAlchemy URL (overrides individual vars if set)
# DATABASE_URL=postgresql://boat:boat@localhost:5432/boat_storage_db

# ─── API Keys ────────────────────────────────────────────────────────────────
# US Census Bureau (free — register at https://api.census.gov/data/key_signup.html)
CENSUS_API_KEY=your_census_api_key_here

# ─── Pipeline Paths ──────────────────────────────────────────────────────────
DATA_DIR=data
OUTPUT_DIR=output
LOG_DIR=logs

# ─── Data Sources ────────────────────────────────────────────────────────────
# Override these if URLs change

# PCPAO parcel shapefile index page
# PCPAO_SHAPEFILE_URL=https://www.pcpao.gov/tools-data/maps-gis/shape-files

# NHD HUC-8 03090202 direct S3 link
NHD_HUC8_URL=https://prd-tnm.s3.amazonaws.com/StagedProducts/Hydrography/NHD/HU8/HighResolution/Shape/NHD_H_03090202_HU8_Shape.zip

# DOR NAL FTP (Pinellas = county 103)
DOR_NAL_COUNTY=103

# FWC ArcGIS REST service
FWC_BOAT_RAMP_URL=https://geodata.myfwc.com/arcgis/rest/services/fishing/FWC_Fishing_Facilities/MapServer/0/query

# OSM Overpass API
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# ─── Pilot Scope ─────────────────────────────────────────────────────────────
COUNTY_FIPS=103
COUNTY_NAME=PINELLAS
NHD_HUC8=03090202

# Pinellas County bounding box (west, south, east, north)
BBOX_WEST=-82.9
BBOX_SOUTH=27.5
BBOX_EAST=-82.2
BBOX_NORTH=28.1

# ─── Pipeline Thresholds ─────────────────────────────────────────────────────
# Minimum building sqft for candidate filter
MIN_BUILDING_SQFT=40000
# Minimum lot size in acres
MIN_LOT_ACRES=2.0
# Approximate registered boats in Pinellas County (from FWC report)
PINELLAS_REGISTERED_BOATS=46000
